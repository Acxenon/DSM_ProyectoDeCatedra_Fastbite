<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" style="@style/FbCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <ImageView android:id="@+id/line_photo" android:layout_width="match_parent" android:layout_height="112dp" android:scaleType="centerCrop" android:src="@drawable/banner_hamburguesa" android:contentDescription="Imagen de la comida" android:background="@drawable/bg_fb_photo" android:clipToOutline="true"/>
    <TextView android:id="@+id/line_name" style="@style/FbSection" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="🍔 Hamburguesa clásica" android:layout_marginTop="10dp"/>
    <TextView android:id="@+id/line_unit_price" style="@style/FbCaption" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="$6.50 por unidad"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/line_total" style="@style/FbPrice" android:layout_width="0dp" android:layout_height="wrap_content" android:text="$13.00" android:layout_weight="1"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/line_decrease" style="@style/FbIconSecondaryButton" android:layout_width="48dp" android:layout_height="48dp" android:text="−" android:layout_marginStart="8dp"/>
        <TextView android:id="@+id/line_quantity" style="@style/FbText" android:layout_width="36dp" android:layout_height="wrap_content" android:text="2" android:gravity="center"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/line_increase" style="@style/FbIconSecondaryButton" android:layout_width="48dp" android:layout_height="48dp" android:text="+" android:layout_marginStart="8dp"/>
    </LinearLayout>
</LinearLayout>
