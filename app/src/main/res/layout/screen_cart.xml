<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/fb_cream">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
        <TextView android:id="@+id/cart_title" style="@style/FbTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tu carrito"/>
        <LinearLayout android:id="@+id/cart_lines" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="8dp"/>
        <include android:id="@+id/cart_summary" layout="@layout/view_summary"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/cart_continue" style="@style/FbPrimaryButton" android:layout_width="match_parent" android:layout_height="52dp" android:text="Continuar con el pedido"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/cart_menu" style="@style/FbSecondaryButton" android:layout_width="match_parent" android:layout_height="52dp" android:text="Añadir más comidas"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/cart_clear" style="@style/FbSecondaryButton" android:layout_width="match_parent" android:layout_height="52dp" android:text="Vaciar carrito"/>
    </LinearLayout>
</ScrollView>
