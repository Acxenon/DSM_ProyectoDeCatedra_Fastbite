<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fb_cream"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingTop="24dp"
        android:paddingBottom="24dp">

        <!-- Marca: el logo y el nombre comparten una misma línea. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/ivLogo"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:padding="5dp"
                android:background="@drawable/bg_login_logo"
                android:src="@drawable/logo_blanco"
                android:scaleType="fitCenter"
                android:clipToOutline="true"
                android:contentDescription="@string/app_name" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="@color/fb_orange"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:textSize="26sp" />

                <TextView
                    android:id="@+id/tvSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/login_brand_subtitle"
                    android:textColor="@color/fb_muted"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/login_welcome_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/login_welcome_title"
            android:textColor="@color/fb_ink"
            android:textSize="27sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:lineSpacingExtra="2dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/login_welcome_description"
            android:textColor="@color/fb_muted"
            android:textSize="14sp"
            android:lineSpacingExtra="2dp" />

        <!-- Fotografía con un degradado para mantener legible el mensaje. -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cvBanner"
            android:layout_width="match_parent"
            android:layout_height="156dp"
            android:layout_marginTop="18dp"
            app:cardCornerRadius="22dp"
            app:cardElevation="0dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/banner_hamburguesa"
                    android:scaleType="centerCrop"
                    android:contentDescription="@string/login_banner_description" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_login_photo_overlay"
                    android:importantForAccessibility="no" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_margin="12dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:background="@drawable/bg_login_badge"
                    android:text="@string/login_banner_badge"
                    android:textColor="@color/fb_orange_dark"
                    android:textStyle="bold"
                    android:textSize="10sp"
                    android:letterSpacing="0.08" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:layout_margin="16dp"
                    android:text="@string/login_banner_caption"
                    android:textColor="@color/fb_white"
                    android:textStyle="bold"
                    android:textSize="20sp"
                    android:shadowColor="#40231D1A"
                    android:shadowRadius="3" />
            </FrameLayout>
        </androidx.cardview.widget.CardView>

        <!-- Formulario de acceso, conservando los IDs usados por LoginActivity. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="@drawable/bg_login_form">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/login_form_title"
                android:textColor="@color/fb_ink"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/lblEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:labelFor="@id/txtEmailAddress"
                android:text="@string/email_label"
                android:textColor="@color/fb_ink"
                android:textStyle="bold"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/txtEmailAddress"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:background="@drawable/bg_login_field"
                android:drawableStart="@android:drawable/ic_dialog_email"
                android:drawablePadding="10dp"
                android:drawableTint="@color/fb_orange_dark"
                android:hint="@string/email_hint_example"
                android:inputType="textEmailAddress"
                android:autofillHints="emailAddress"
                android:imeOptions="actionNext"
                android:singleLine="true"
                android:textColor="@color/fb_ink"
                android:textColorHint="@color/fb_muted"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/lblPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:labelFor="@id/txtPassword"
                android:text="@string/password_label"
                android:textColor="@color/fb_ink"
                android:textStyle="bold"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/txtPassword"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:background="@drawable/bg_login_field"
                android:drawableStart="@android:drawable/ic_lock_idle_lock"
                android:drawablePadding="10dp"
                android:drawableTint="@color/fb_orange_dark"
                android:hint="@string/password_hint_stars"
                android:inputType="textPassword"
                android:autofillHints="password"
                android:imeOptions="actionDone"
                android:singleLine="true"
                android:textColor="@color/fb_ink"
                android:textColorHint="@color/fb_muted"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvForgot"
                android:clickable="true"
                android:focusable="true"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical|end"
                android:text="@string/login_forgot_password"
                android:textColor="@color/fb_orange_dark"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogin"
                style="@style/FbPrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="0dp"
                android:text="@string/login_button"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/login_new_customer"
                android:textColor="@color/fb_muted"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvRegister"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/login_create_account"
                android:textColor="@color/fb_orange_dark"
                android:textStyle="bold"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
