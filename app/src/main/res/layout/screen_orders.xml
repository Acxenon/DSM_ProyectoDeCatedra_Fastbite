<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/fb_cream">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
        <TextView android:id="@+id/orders_title" style="@style/FbTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Mis pedidos"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/orders_refresh" style="@style/FbSecondaryButton" android:layout_width="match_parent" android:layout_height="52dp" android:text="↻ Actualizar historial"/>
        <TextView android:id="@+id/orders_sync" style="@style/FbCaption" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Los pedidos se guardan en este dispositivo."/>
        <EditText android:id="@+id/orders_search" style="@style/FbField" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Busca comida, fecha o número de pedido" android:singleLine="true"/>
        <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:scrollbars="none">
            <LinearLayout android:id="@+id/orders_filters" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal"/>
        </HorizontalScrollView>
        <LinearLayout android:id="@+id/orders_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="8dp"/>
    </LinearLayout>
</ScrollView>
