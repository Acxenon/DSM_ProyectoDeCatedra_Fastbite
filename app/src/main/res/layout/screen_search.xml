<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/fb_cream">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
        <TextView android:id="@+id/search_title" style="@style/FbTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Menú completo"/>
        <TextView android:id="@+id/search_subtitle" style="@style/FbCaption" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Explora nuestros platos y añade tus favoritos."/>
        <EditText android:id="@+id/search_input" style="@style/FbField" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Busca comidas o ingredientes" android:singleLine="true"/>
        <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:scrollbars="none">
            <LinearLayout android:id="@+id/search_categories" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal"/>
        </HorizontalScrollView>
        <TextView android:id="@+id/search_count" style="@style/FbCaption" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="22 opciones"/>
        <LinearLayout android:id="@+id/search_food_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="8dp"/>
    </LinearLayout>
</ScrollView>
