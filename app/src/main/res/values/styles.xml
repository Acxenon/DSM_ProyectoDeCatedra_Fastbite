<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="FbText">
        <item name="android:textColor">@color/fb_ink</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>
    <style name="FbTitle" parent="FbText">
        <item name="android:textSize">25sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="FbSection" parent="FbText">
        <item name="android:textSize">19sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginTop">20dp</item>
    </style>
    <style name="FbCaption" parent="FbText">
        <item name="android:textColor">@color/fb_muted</item>
        <item name="android:textSize">12sp</item>
        <item name="android:layout_marginTop">6dp</item>
    </style>
    <style name="FbPrice" parent="FbText">
        <item name="android:textColor">@color/fb_orange</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">17sp</item>
    </style>
    <style name="FbField">
        <item name="android:textColor">@color/fb_ink</item>
        <item name="android:textColorHint">@color/fb_muted</item>
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:padding">14dp</item>
        <item name="android:background">@drawable/bg_fb_field</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:maxLength">1000</item>
        <item name="android:inputType">text</item>
    </style>
    <style name="FbCard">
        <item name="android:background">@drawable/bg_fb_card</item>
        <item name="android:padding">14dp</item>
        <item name="android:layout_marginTop">12dp</item>
    </style>
    <style name="FbNav" parent="FbText">
        <item name="android:gravity">center</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:padding">8dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
    <style name="FbPrimaryButton" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/fb_orange</item>
        <item name="android:textColor">@color/fb_white</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:gravity">center</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:autoSizeTextType">none</item>
        <item name="autoSizeTextType">none</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:elevation">0dp</item>
    </style>
    <style name="FbSecondaryButton" parent="FbPrimaryButton">
        <item name="backgroundTint">@color/fb_pale</item>
        <item name="android:textColor">@color/fb_orange_dark</item>
    </style>
    <style name="FbIconPrimaryButton" parent="FbPrimaryButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingLeft">0dp</item>
        <item name="android:paddingRight">0dp</item>
        <item name="android:textSize">23sp</item>
        <item name="android:layout_marginTop">0dp</item>
        <item name="cornerRadius">14dp</item>
    </style>
    <style name="FbIconSecondaryButton" parent="FbSecondaryButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingLeft">0dp</item>
        <item name="android:paddingRight">0dp</item>
        <item name="android:textSize">23sp</item>
        <item name="android:layout_marginTop">0dp</item>
        <item name="cornerRadius">14dp</item>
    </style>
</resources>
